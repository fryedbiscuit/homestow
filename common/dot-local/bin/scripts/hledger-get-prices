#!/usr/bin/python
import urllib.request
import json
from datetime import datetime

# AwesomeAPI endpoint for USD-BRL, EUR-BRL, and BTC-BRL
API_URL = "https://economia.awesomeapi.com.br/last/USD-BRL,EUR-BRL,BTC-BRL"

def update_prices():
    try:
        # Fetch data from the API
        response = urllib.request.urlopen(API_URL)
        data = json.loads(response.read())
        
        # Get current date and time in hledger format
        now = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
        
        # Extract the 'bid' (compra) price for each
        usd_price = float(data['USDBRL']['bid'])
        eur_price = float(data['EURBRL']['bid'])
        btc_price = float(data['BTCBRL']['bid'])
        
        # Print the P directives
        print(f"P {now} $ {usd_price:.2f} R$")
        print(f"P {now} € {eur_price:.2f} R$")
        print(f"P {now} BTC {btc_price:.2f} R$")
        
    except Exception as e:
        print(f"; Error fetching prices: {e}")

if __name__ == "__main__":
    update_prices()

